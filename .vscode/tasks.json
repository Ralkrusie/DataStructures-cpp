{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "CMake: Configure",
			"type": "shell",
			"command": "${workspaceFolder}\\.vscode\\configure-vs2026.cmd",
			"options": {
				"env": {
					"VSLANG": "1033"
				}
			},
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "CMake: Build",
			"type": "shell",
			"command": "${workspaceFolder}\\.vscode\\build-vs2026.cmd",
			"options": {
				"env": {
					"VSLANG": "1033"
				}
			},
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"dependsOn": [
				"CMake: Configure"
			],
			"problemMatcher": [
				"$msCompile"
			]
		},
		{
			"label": "CMake: Build Target",
			"type": "shell",
			"command": "${workspaceFolder}\\.vscode\\build-target-vs2026.cmd",
			"options": {
				"env": {
					"VSLANG": "1033"
				}
			},
			"args": [
				"${input:cmakeTarget}"
			],
			"dependsOn": [
				"CMake: Configure"
			],
			"group": "build",
			"problemMatcher": [
				"$msCompile"
			]
		},
		{
			"label": "CTest: Run All",
			"type": "shell",
			"command": "ctest",
			"options": {
				"env": {
					"VSLANG": "1033"
				}
			},
			"args": [
				"--test-dir",
				"${workspaceFolder}/build",
				"-C",
				"Debug",
				"--output-on-failure"
			],
			"dependsOn": [
				"CMake: Build"
			],
			"group": "test",
			"problemMatcher": []
		}
	],
	"inputs": [
		{
			"id": "cmakeTarget",
			"type": "promptString",
			"description": "Input target name, e.g. test_test_single_list_basic"
		}
	]
}
